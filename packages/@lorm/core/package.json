{
  "name": "@lorm/core",
  "version": "0.1.34",
  "description": "Core functionality and shared infrastructure for lorm - mobile-first framework",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure/index.d.ts",
      "import": "./dist/infrastructure/index.js",
      "require": "./dist/infrastructure/index.cjs"
    },
    "./infrastructure/cache": {
      "types": "./dist/infrastructure/cache/index.d.ts",
      "import": "./dist/infrastructure/cache/index.js",
      "require": "./dist/infrastructure/cache/index.cjs"
    },
    "./infrastructure/performance": {
      "types": "./dist/infrastructure/performance/index.d.ts",
      "import": "./dist/infrastructure/performance/index.js",
      "require": "./dist/infrastructure/performance/index.cjs"
    },
    "./infrastructure/security": {
      "types": "./dist/infrastructure/security/index.d.ts",
      "import": "./dist/infrastructure/security/index.js",
      "require": "./dist/infrastructure/security/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "size": "tsx ../../../scripts/bundle-size.ts",
    "size:check": "pnpm build && pnpm size",
    "size:watch": "pnpm build && pnpm size && echo '\nWatching for changes...' && pnpm build --watch"
  },
  "dependencies": {
    "@libsql/client": "^0.15.9",
    "@neondatabase/serverless": "^1.0.1",
    "typed-rpc": "^2.0.0",
    "@planetscale/database": "^1.19.0",
    "better-sqlite3": "^12.2.0",
    "chalk": "^5.3.0",
    "dotenv": "^17.0.1",
    "drizzle-orm": "^0.44.2",
    "mysql2": "^3.14.2",
    "postgres": "^3.4.7",
    "zod": "^4.0.0",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "semver": "^7.6.3",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.15.4",
    "terser": "^5.43.1",
    "tsx": "^4.20.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JohnClever/lorm.git",
    "directory": "packages/@lorm/core"
  },
  "publishConfig": {
    "access": "public"
  }
}